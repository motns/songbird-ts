{
  "name": "songbird",
  "version": "0.0.1",
  "license": "MIT",
  "files": [
    "/dist"
  ],
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc --build tsconfig.build.json",
    "coverage": "vitest run --coverage",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "test": "tsc --noEmit -p tsconfig.test.json && vitest run",
    "test:type": "tsc --noEmit -p tsconfig.test.json",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration"
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "^9.1.0",
    "@types/express": "^5.0.6",
    "@types/lodash": "^4.17.25",
    "@types/luxon": "^3.7.4",
    "express": "^5.2.1",
    "lodash": "^4.18.1",
    "luxon": "^3.7.2",
    "openapi-types": "^12.1.3",
    "openapi3-ts": "^4.6.1",
    "remeda": "^2.45.0",
    "xmlbuilder2": "^4.0.3",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/node": "^26.2.0",
    "@vitest/coverage-v8": "^4.1.11",
    "cookie-parser": "^1.4.7",
    "oxfmt": "^0.63.0",
    "oxlint": "^1.78.0",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "zod": "^4.4.3"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^11.25.0"
    }
  }
}
